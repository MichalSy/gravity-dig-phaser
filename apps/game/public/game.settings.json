{
  "$schema": "schemas/game-settings.schema.json",
  "version": 1,
  "assets": {
    "manifest": "assets/assets.manifest.json"
  },
  "scenes": {
    "startup": "menu",
    "editorDefault": "gameplay",
    "definitions": {
      "menu": {
        "path": "scenes/menu.scene.json",
        "assetGroups": ["startup"]
      },
      "loading": {
        "path": "scenes/loading.scene.json",
        "assetGroups": ["startup"]
      },
      "gameplay": {
        "path": "scenes/gameplay.scene.json",
        "assetGroups": ["gameplay"],
        "prefabs": [
          "prefabs/player.prefab.json",
          "prefabs/ship.prefab.json"
        ]
      }
    }
  },
  "actions": {
    "game:start": {
      "type": "mountScene",
      "scene": "loading",
      "unmount": ["menu"]
    },
    "game:load": {
      "type": "loadSceneAssets",
      "scene": "gameplay"
    },
    "game:mount": {
      "type": "mountScene",
      "scene": "gameplay",
      "unmount": ["menu", "loading"]
    },
    "player:jump": {
      "type": "playSound",
      "asset": "jump",
      "volume": 0.42,
      "detune": 40
    }
  },
  "managers": [
    {
      "id": "gameplay-input",
      "path": "scripts/Managers/GameplayInput.manager.json",
      "mountWhen": ["gameplay"],
      "lifetime": "runtime",
      "modes": ["play", "editor"],
      "order": 100
    },
    {
      "id": "player-state",
      "path": "scripts/PlayerState/PlayerStateManager.manager.json",
      "mountWhen": ["gameplay"],
      "lifetime": "runtime",
      "modes": ["play", "editor"],
      "order": 200
    },
    {
      "id": "level",
      "path": "scripts/Managers/LevelManager.manager.json",
      "mountWhen": ["gameplay"],
      "lifetime": "runtime",
      "modes": ["play", "editor"],
      "dependsOn": ["player-state"],
      "order": 300
    }
  ]
}
